{
  "base_url": {
    "description": "菌菌控制台公开 API Base URL",
    "type": "text",
    "hint": "默认 https://kinoko.zorua.cn/api/v1",
    "default": "https://kinoko.zorua.cn/api/v1"
  },
  "default_server": {
    "description": "默认服务器（查询时未显式指定则使用）",
    "type": "text",
    "hint": "cn / jp / custom",
    "default": "cn"
  },
  "request_timeout": {
    "description": "请求超时（秒）",
    "type": "int",
    "hint": "建议 10~60",
    "default": 30
  },
  "sync_ttl": {
    "description": "成绩同步缓存有效期（秒），过期后重新拉取菌菌 API",
    "type": "int",
    "hint": "建议 300~3600",
    "default": 300
  },
  "storage_quota_mb": {
    "description": "本地存储配额（MiB），用于空间监管",
    "type": "int",
    "hint": "默认 256 MiB",
    "default": 256
  },
  "storage_warn_ratio": {
    "description": "存储告警阈值（占用比例，0~1），超过则提醒管理员",
    "type": "float",
    "hint": "默认 0.8（80%）",
    "default": 0.8
  }
}
